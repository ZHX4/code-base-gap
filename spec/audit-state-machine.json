{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-base-gap.dev/spec/audit-state-machine.json",
  "title": "Code Base Gap Audit State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "terminal_states", "failure_classes", "states"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "terminal_states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failure_classes": {
      "type": "array",
      "items": {"type": "string", "enum": ["transient", "configuration", "unsupported", "security_block", "resource_limit", "tool_failure", "model_failure", "repository_failure", "internal_bug"]},
      "uniqueItems": true
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["terminal", "transitions"],
        "properties": {
          "terminal": {"type": "boolean"},
          "transitions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
