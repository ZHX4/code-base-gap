{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-base-gap.dev/schema/hypothesis.schema.json",
  "title": "Code Base Gap Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis_id", "category", "statement", "affected_scope", "supporting_evidence", "expected_observations", "verification_plan", "priority", "status"],
  "properties": {
    "hypothesis_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "affected_scope": {"type": "string", "minLength": 1},
    "supporting_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_observations": {"type": "array", "items": {"type": "string"}},
    "verification_plan": {"type": "string", "minLength": 1},
    "priority": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]},
    "status": {"type": "string", "enum": ["open", "investigating", "verified", "likely", "unverified", "rejected"]}
  }
}
