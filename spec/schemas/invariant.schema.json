{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-base-gap.dev/schema/invariant.schema.json",
  "title": "Code Base Gap Invariant",
  "type": "object",
  "additionalProperties": false,
  "required": ["invariant_id", "statement", "category", "origin", "scope", "supporting_evidence", "confidence", "status"],
  "properties": {
    "invariant_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "enum": ["explicit", "inferred", "unknown"]},
    "scope": {"type": "string", "minLength": 1},
    "supporting_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["active", "challenged", "rejected"]}
  }
}
